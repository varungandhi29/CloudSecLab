# ==============================================================================
# CloudSecLab Production & Development Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values before starting.
# NEVER commit your production .env file with real secrets to version control.
# ==============================================================================

# Application Environment (development | production | staging)
ENVIRONMENT=production

# JWT Signing Secret (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_a_cryptographically_secure_256bit_random_secret_here

# Public Key / Token Algorithm
PUBLIC_KEY=dev-public-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_DB=cloudseclab
POSTGRES_USER=cloudseclab
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://cloudseclab:your_secure_postgres_password_here@postgres:5432/cloudseclab

# Redis Cache & Session Store URL
# Format: redis://<host>:<port>
REDIS_URL=redis://redis:6379

# LocalStack AWS Emulation Endpoint URL
# Default in Docker network: http://localstack:4566
# Default local standalone: http://localhost:4566
LOCALSTACK_ENDPOINT=http://localstack:4566

# Frontend Public Origin URL (for CORS and Certificate verification links)
FRONTEND_URL=https://cloudseclab.onrender.com

# Frontend API Base URL (passed to Vite during build or runtime)
VITE_API_URL=https://cloudseclab-backend.onrender.com/api

# Seeding & Demo Data Configuration
# Set to true ONLY if you want an initial demo account created with random credentials
SEED_DEMO_DATA=false

          "aws --endpoint-url=http://localhost:4566 iam create-user --user-name readonly-audit",
          "aws --endpoint-url=http://localhost:4566 iam attach-user-policy --user-name svc-deploy --policy-arn arn:aws:iam::aws:policy/AdministratorAccess"
        ],
